{
  "name": "notifymvp",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notifymvp-db",
      "database_id": "4136aebf-5be0-4e4e-b65b-e21c9887ab55"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "firebase-credentials"
    }
  ],

  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://notifymvp.aslamqadri.workers.dev"
  },

  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
